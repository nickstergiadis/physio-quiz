{
  "name": "physio-quiz",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "find src scripts -name '*.js' -o -name '*.mjs' | xargs -I{} node --check {}",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.js",
    "validate:questions": "node scripts/validateQuestionBank.mjs",
    "release:check": "npm run check && npm test && npm run validate:questions && npm run build"
  }
}
